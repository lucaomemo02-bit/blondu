{
  "name": "blondu-desktop",
  "version": "1.0.0",
  "description": "Blondu para computador",
  "author": "Blondu",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.blondu.chat",
    "productName": "Blondu",
    "directories": { "output": "dist" },
    "files": ["main.js", "www/**/*", "build/icon.png"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.social-networking" },
    "linux": { "target": ["AppImage"], "category": "Network" }
  }
}
